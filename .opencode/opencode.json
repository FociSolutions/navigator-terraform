{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "terraform": {
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf"]
    }
  },
  "mcp": {
    "microsoft-docs": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "terraform": {
      "type": "local",
      "command": ["docker",
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:0.3.3"
      ],
      // Enable during implementaion to access up-to-date provider information
      "enabled": false,
    },
    "azure": {
      "type": "local",
      "command": ["npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      // Enable during debugging
      "enabled": false,
    }
  },
  "instructions": [".github/instructions/terraform.instructions.md"],
  "permission": {
    "bash": "ask",
  }
}
